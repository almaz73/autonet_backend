<!DOCTYPE html>
<html lang='ru'>
<head>
    <meta charset='UTF-8'/>
    <link rel='icon' type='image/svg+xml' sizes='any' href='/st/favicon.svg'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title><%= title %></title>
    <meta property='og:type' content='website'>
    <meta property='og:title' content='<%= title %>'>
    <meta property='og:image' content='https://xn--80aej9aped4f.xn--p1ai/st/auto.webp'>
    <link rel="canonical" href="https://автосеть.рф/cars/<%- brand %>/<%- model %>/<%- linkId %>" />
    <meta property='og:url' content='https://автосеть.рф/cars/<%- brand %>/<%- model %>/<%- linkId %>'>
    <meta property='og:locale' content='ru_RU'>
    <meta property='og:site_name' content='АВТОСЕТЬ.РФ'>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8'>
    <meta name='robots' content='index, follow'>
    <meta name='keywords' content='<%= keywords %>'>
    <meta name='description' content='<%= description %>'>

    <link rel="stylesheet" crossorigin href="/assets/<%- css1 %>">
    <link rel="stylesheet" crossorigin href="/<%- css2 %>">
    <link rel="stylesheet" crossorigin href="/<%- css3 %>">

    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">

    <script src='/st/swiper-bundle.min.js'></script>

    <script type="module" crossorigin src="/assets/<%- js1 %>"></script>
    <script type="module" crossorigin src="/assets/<%- js2 %>"></script>
    <script type="module" crossorigin src="/assets/<%- js3 %>"></script>
    <script type="module" crossorigin src="/assets/<%- js4 %>"></script>
    <script type="module" crossorigin src="/assets/<%- js5 %>"></script>
    <script type="module" crossorigin src="/<%- carjs %>"></script>
</head>
<body>


<%- include('partials/verbox') %>
<%- include('partials/ya_metrica') %>
<%- include('partials/header') %>

<main>
    <div class='page_padding_20'>
        <div class='bread_cranbs'>
            <a href='/'>Главная</a> /
            <a href='/cars'>Автомобили</a> /
            <span id='auto-brand-path'>
                <a href='/cars<% if (carData.brand){ %>/0/<%- carData.brand %><% } %>'>
                  Автомобили <%- carData.brand %> с пробегом
                </a>
            </span> /
            <span class='auto-name'>
                <%- title %>
            </span>
        </div>
    </div>

    <div class='container'>
        <div class='alone'>
            <div class='left'>
                <%- include('partials/car/big-photo')%>
                <%- include('partials/car/address')%>
                <div class='sticky-left'>
                    <%- include('partials/car/charaсteristiс')%>
                </div>
                <%- include('partials/car/equipment')%>
                <abdul></abdul>
                <%- include('partials/car/cred')%>
            </div>
            <div class='right'>
                <div class='sticky'>
                    <%- include('partials/car/charaсteristiс')%>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>

</body>
</html>