<span class='comb' data-placeholder='<%= name %>'>
    <div class='big-combo' tabindex='1' title='<%= name %>'>
        <span class='big-comb__selected'>
            <span class='big-comb__placeholder'><%= name %></span>
            <input class='big-comb__input' type="text" inputmode="none">
        </span>
        <img src='/st/svg/arrow-down.svg' alt='arrow' loading='lazy' width='10' height='18'>
        <div class='big_comb__items' onclick='big_comb_select(event)'></div>
    </div>
</span>
