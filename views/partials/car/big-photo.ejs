<div class='big'>
  <div class='x' onclick='toBig()'><img src='/st/close.webp' loading='lazy' alt=''></div>
  <section class='swiper mySwiper'>
    <div class='open_all' onclick='toBig("big")'>На весь экран</div>
    <div class='swiper-wrapper' id='auto-swip'>
      <% if(carData.images && carData.images.length){ %>
      <img src="<%- carData.images[0] %>">
      <% } %>
    </div>
    <div class='swiper-button-next'></div>
    <div class='swiper-button-prev'></div>
    <div class='swiper-pagination'></div>
  </section>
  <div class='fotos' id='auto-more'></div>
  <span class='dark-fon' onclick='closeChat()'/>
</div>