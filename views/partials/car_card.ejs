<div class='cart' id='galery_<%= idx %>'>
    <div class='cart__slide'>
        <span class='dark-fon'></span>
        <div class="fast_show">Быстрый просмотр</div>
        <img class='photo' alt='' src="<%= car.images[0] %>">
        <div class='cart__blank'><%= car.address %></div>
        <div class='field'><div class='red'></div></div>
    </div>
    <a class="big_link"
       href="<%= car.href %>"
       onclick="openCar('<%= car.href %>','<%= car.images[0] %>')"
       data-href="<%= car.href %>"
       title="Перейти к характеристикам автомобиля">
        <div class='name'>
            <br>
            <%= car.name %>, <%= car.yearReleased %>
        </div>
        <div class='cart__price'>
            <div class='total'><%= car.price ? car.price + ' ₽' : '' %> </div>
            <div class='cart__of'><%= car.fromPerMonth ? 'ot ' + car.fromPerMonth + ' ₽/мес' : '' %></div>
        </div>
        <div class='cart__info'>
            <%- car.info %>
        </div>
        <div class='cart__box--bottom'>
            <a href="javascript:addCompare('<%= car.id %>')"
               title="Добавить в список сравнения"
               ondblclick="dblCompare('<%= car.id %>')">
                <img id="compareId_<%= car.id %>" src='/st/icons/compare_cars.svg' alt=''>
            </a>
            <a href="javascript:addFavorite('<%= car.id %>')" title="Добавить в избранные">
                <img id="favoriteId_<%= car.id %>" src='/st/icons/penta.svg' alt=''>
            </a>
        </div>
    </a>
</div>
