<!DOCTYPE html>
<html lang='ru'>
<head>
    <meta charset='UTF-8'/>
    <link rel='icon' type='image/svg+xml' sizes='any' href='/st/favicon.svg'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title><%= title %></title>
    <meta property='og:type' content='website'>
    <meta property='og:title' content='<%= title %>'>
    <meta property='og:image' content='<%= photoUrl ? `https://автосеть.рф${photoUrl}` : "https://xn--80aej9aped4f.xn--p1ai/st/auto.webp" %>'>
    <link rel='canonical' href='https://автосеть.рф<%= dealer.link %>'>
    <meta property='og:url' content='https://автосеть.рф<%= dealer.link %>'>
    <meta property='og:locale' content='ru_RU'>
    <meta property='og:site_name' content='АВТОСЕТЬ.РФ'>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8'>
    <meta name='robots' content='index, follow'>
    <meta name='description' content='<%= description %>'>

    <link rel='stylesheet' crossorigin href='/<%= styleCss %>'>
    <link rel='stylesheet' crossorigin href='/<%= contactsCss %>'>
    <link rel='sitemap' type='application/xml' title='Sitemap' href='/sitemap.xml'>

    <% if (styleJs) { %><script type='module' crossorigin src='/<%= styleJs %>'></script><% } %>
    <script type='module' crossorigin src='/<%= mainJs %>'></script>
</head>
<body>

<%- include('partials/verbox') %>
<%- include('partials/ya_metrica') %>
<%- include('partials/header') %>

<main class='contacts dealer-page'>
    <div class='page_padding_20'>
        <div class='bread_cranbs'>
            <a href='/'>Главная</a> /
            <a href='/contacts/'>Контакты</a> /
            <span><%= dealer.city %>, <%= addressText %></span>
        </div>
    </div>

    <h1><%= dealer.profile %> в г. <%= dealer.city %></h1>

    <%- include('partials/dealer_card') %>
</main>

<%- include('partials/footer') %>

</body>
</html>
