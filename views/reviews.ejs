<!DOCTYPE html>
<html lang='ru'>
<head>
    <link rel='icon' type='image/svg+xml' sizes='any' href='/st/favicon.svg'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'/>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title><%= title %></title>
    <link rel="canonical" href="<%= canonical %>"/>
    <meta property='og:type' content='website'>
    <meta property='og:title' content='<%= title %>'>
    <meta property='og:description' content='<%= description %>'>
    <meta property='og:image' content='<%= ogImage %>'>
    <meta property='og:url' content='<%= canonical %>'>
    <meta property='og:locale' content='ru_RU'>
    <meta property='og:site_name' content='АВТОСЕТЬ.РФ'>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8'>
    <meta name='robots' content='index, follow'>
    <meta name='description' content='<%= description %>'>
    <% jsFiles.forEach(file => { %>
    <script type="module" crossorigin src="/assets/<%= file %>"></script>
    <% }) %>
    <% cssFiles.forEach(file => { %>
    <link rel="stylesheet" crossorigin href="/assets/<%= file %>">
    <% }) %>
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
</head>
<body>

<%- include('partials/verbox') %>
<%- include('partials/ya_metrica') %>
<%- include('partials/header') %>

<main class="reviews-page">

    <div class='page_padding_20'>
        <div class='bread_cranbs'>
            <a href='/'>Главная</a> /
            <a href='/reviews/'>Отзывы</a>
        </div>
    </div>

    <h1>Отзывы об Автосеть.РФ</h1>

    <p class="reviews-page__intro">
        Здесь собраны отзывы наших клиентов о покупке автомобилей с пробегом, продаже авто и сервисном обслуживании.
    </p>

    <section class="review-sources-block">
        <h2>Оставить отзыв</h2>

        <form class="review-form" id="review-form" novalidate>
            <div class="review-form__row">
                <label class="review-form__label" for="review-fio">Ваше имя *</label>
                <input type="text" id="review-fio" name="fio" required maxlength="120" autocomplete="name"
                       placeholder="Как к вам обращаться">
            </div>

            <div class="review-form__row">
                <span class="review-form__label">Оценка</span>
                <div class="review-form__stars" role="radiogroup" aria-label="Оценка от 1 до 5">
                    <% [5, 4, 3, 2, 1].forEach(value => { %>
                    <input type="radio" name="rating" id="review-rating-<%= value %>" value="<%= value %>"
                           aria-label="<%= value %> из 5"<% if (value === 5) { %> checked<% } %>>
                    <% }); %>
                </div>
            </div>

            <div class="review-form__row">
                <label class="review-form__label" for="review-text">Отзыв *</label>
                <textarea id="review-text" name="review" rows="6" required maxlength="5000"
                          placeholder="Расскажите о вашем опыте"></textarea>
            </div>

            <div class="review-form__row">
                <div class="capctha-div"></div>
            </div>


            <button type="submit" class="page__btn page__btn--main">Сохранить</button>
        </form>

        <div class="review-form__success" id="review-form-success" hidden>
            Спасибо! Ваш отзыв принят, будет опубликован после модерации
        </div>

        <p class="review-sources-note">Будем благодарны за отзыв о работе автосалона на любой удобной площадке:</p>
        <p class="review-sources-note">Отзывы о каждом дилерском центре собраны в разделе
            <a href="/contacts/">«Контакты»</a> — со ссылками на Яндекс Карты, Google, 2ГИС и Авито.</p>
    </section>

    <div class="review-list" id="review-list">
        <% if (!items.length) { %>
        <p class="page_padding_20">Пока нет опубликованных отзывов.</p>
        <% } %>
        <% items.forEach(item => { %>
        <article class="review-card">
            <div class="review-card__head">
                <span class="review-card__author"><%= item.author %></span>
                <span class="review-card__date"><%= item.dateText %></span>
            </div>
            <div class="review-card__meta">
                <span class="review-stars" aria-label="Оценка <%= item.rating %> из 5"
                ><%- '★'.repeat(item.rating) %><span class="review-stars__empty"><%- '★'.repeat(5 - item.rating) %></span></span>
                <% if (item.platformHref) { %>
                <a class="review-card__source" href="<%= item.platformHref %>" target="_blank"
                   rel="noopener noreferrer nofollow"><%= item.platformLabel %></a>
                <% } else { %>
                <span class="review-card__source"><%= item.platformLabel %></span>
                <% } %>
            </div>
            <p class="review-card__text"><%= item.text %></p>
            <% if (item.answer) { %>
            <div class="review-card__answer">
                <div class="review-card__answer-head">
                    Ответ <%= item.respondent || 'Автосеть.РФ' %><% if (item.answerDateText) { %>, <%= item.answerDateText %><% } %>
                </div>
                <p class="review-card__answer-text"><%= item.answer %></p>
            </div>
            <% } %>
        </article>
        <% }); %>
    </div>

    <% if (totalPages > 1) { %>
    <div class='bottom-nav pager'>
        Страницы: <span id='pager'>
            <% pagerLinks.forEach((link, index) => { %>
            <a<% if (link.active) { %> class="active"<% } %> href="<%= link.href %>"><%= link.page %></a>
            <% if (index < pagerLinks.length - 1) { %><span style="color: #bbb"> | </span><% } %>
            <% }) %>
            <% if (nextHref) { %> <a href="<%= nextHref %>">След.</a><% } %>
        </span>
    </div>
    <% } %>

    <br><br>
</main>

<%- include('partials/footer') %>

</body>
</html>
