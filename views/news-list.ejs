<!DOCTYPE html>
<html lang='ru'>
<head>
    <link rel='icon' type='image/svg+xml' sizes='any' href='/st/favicon.svg'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'/>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title><%= title %></title>
    <link rel="canonical" href="<%= canonical %>"/>
    <meta property='og:type' content='website'>
    <meta property='og:title' content='<%= title %>'>
    <meta property='og:description' content='<%= description %>'>
    <meta property='og:image' content='<%= ogImage %>'>
    <meta property='og:url' content='<%= canonical %>'>
    <meta property='og:locale' content='ru_RU'>
    <meta property='og:site_name' content='АВТОСЕТЬ.РФ'>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8'>
    <meta name='robots' content='index, follow'>
    <meta name='description' content='<%= description %>'>
    <% jsFiles.forEach(file => { %>
    <script type="module" crossorigin src="/assets/<%= file %>"></script>
    <% }) %>
    <% cssFiles.forEach(file => { %>
    <link rel="stylesheet" crossorigin href="/assets/<%= file %>">
    <% }) %>
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
</head>
<body>

<%- include('partials/verbox') %>
<%- include('partials/ya_metrica') %>
<%- include('partials/header') %>

<main>

    <div class='page_padding_20'>
        <div class='bread_cranbs'>
            <a href='/'>Главная</a> /
            <a href='/news/'>Новости</a>
        </div>
    </div>

    <h1>Новости и статьи</h1>

    <div class='news' id='news-div' data-ssr='1'>
        <% if (!items.length) { %>
        <p class='page_padding_20'>Пока нет опубликованных статей.</p>
        <% } %>
        <% items.forEach(item => { %>
        <div class="news-card">
            <a href="<%= item.url %>"><img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy"></a>
            <div class="news-content">
                <h3><%= item.name %></h3>
                <p>
                    <%= item.announce %>
                </p>
            </div>
            <div class="grow"></div>
            <div class="news-meta">
                <span class="news-date"><%= item.dateText %></span>
                <a href="<%= item.url %>" class="page__btn page__btn--current read-more-btn">
                    <span> Читать далее </span>
                </a>
            </div>
        </div>
        <% }) %>
    </div>

    <% if (totalPages > 1) { %>
    <div class='bottom-nav pager'>
        Страницы: <span id='pager'>
            <% pagerLinks.forEach((link, index) => { %>
            <a<% if (link.active) { %> class="active"<% } %> href="<%= link.href %>"><%= link.page %></a>
            <% if (index < pagerLinks.length - 1) { %><span style="color: #bbb"> | </span><% } %>
            <% }) %>
            <% if (nextHref) { %> <a href="<%= nextHref %>">След.</a><% } %>
        </span>
    </div>
    <% } %>

    <br><br>
</main>

<%- include('partials/footer') %>

</body>
</html>
