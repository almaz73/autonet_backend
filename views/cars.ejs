<!DOCTYPE html>
<html lang='ru'>
<head>
    <meta charset='UTF-8'/>
    <link rel='icon' type='image/svg+xml' sizes='any' href='/st/favicon.svg'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'/>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title><%- title %></title>
    <meta property='og:type' content='website'>
    <meta property='og:title'
          content='Каталог автомобилей с пробегом (БУ). Купить авто из наличия в автосалонах Казани и всей России - Автосеть.РФ'>
    <meta property='og:image' content='https://xn--80aej9aped4f.xn--p1ai/st/auto.webp'>
    <% if (ssr_brandSearch){ %>
        <link rel="canonical" href="https://автосеть.рф/cars/<%- ssr_page %>/<%- ssr_brandSearch %>" />
    <% } else { %>
        <link rel="canonical" href="https://автосеть.рф/cars<% if (ssr_page>0){ %>/<%- ssr_page %><%}%>" />
    <% } %>
    <meta property='og:url' content='https://автосеть.рф/cars/<%- ssr_page %>/<%- ssr_brandSearch %>'>
    <meta property='og:locale' content='ru_RU'>
    <meta property='og:site_name' content='АВТОСЕТЬ.РФ'>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8'>
    <meta name='robots' content='index, follow'>
    <meta name='keywords' content='Купить автомобили с пробегом, авто в Казани'>
    <meta name='description'
          content='Цены на Б/У авто 🚗 в автосалонах Автосеть.рф в Казани, Уфе, Набережных челнах, Нижнекамске, Самаре и других городах России.
          ✅ Купить автомобили с пробегом из каталога - иномарки, Lada в наличии. ☎ Звоните по телефону 8-800-500-11-56.'>

    <link rel="stylesheet" crossorigin href="/assets/<%- css1 %>">
    <link rel="stylesheet" crossorigin href="/<%- css2 %>">
    <link rel="stylesheet" crossorigin href="/<%- css3 %>">

    <script type="module" crossorigin src="/assets/<%- js1 %>"></script>
    <script type="module" crossorigin src="/assets/<%- js2 %>"></script>
    <script type="module" crossorigin src="/<%- carsjs %>"></script>


    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
    <link rel="preload" href="/st/fonts/Gilroy-Light.otf" as="font" type="font/otf" crossorigin>
    <link rel="preload" href="/st/fonts/Gilroy-ExtraBold.otf" as="font" type="font/otf" crossorigin>
    <script>
        var ssr_page = '<%- ssr_page %>';
        var ssr_brandSearch = '<%- ssr_brandSearch %>'
        var ssr_page_total = '<%- ssr_page_total %>'
    </script>
    <script>
        window.__carsSSR = <%- carsSSRJson %>;
    </script>
</head>
<body>

<%- include('partials/verbox') %>
<%- include('partials/ya_metrica') %>
<%- include('partials/header') %>

<main>

    <div class='page_padding_20'>
        <div class='bread_cranbs'>
            <a href='/'>Главная</a> /
            <a href='/cars'>Автомобили</a>
            <% if (brand){ %>/
            <div id='path'><%- brand %></div>
            <% } %>
        </div>
    </div>

    <div id='filter_cars'>
        <%- include('partials/filter_cars', {filterActive: filterActive}) %>
    </div>

    <div id='brands_dynamic' class='container main__top--block'<% if (filterActive) { %> style="display: none"<% } %>>
        <div class='list_brands'>
            <% carCount.forEach(function(el) { %>
                <% if (el.count) { %>
                    <div>
                        <a href='/cars/0/<%= el.latBrand %>'>
                            <span class='icon' style="width: 37px;height: 29px"></span>
                            <span class='text'><%= el.name.toUpperCase() %></span>
                            <span class='total'><%= el.count %></span>
                        </a>
                    </div>
                <% } %>
            <% }); %>
        </div>
    </div>

    <div id='car-vitrina' class='container'>
        <div class="car_vitrina">
            <h1 id="vitrina_name"><%= vitrinaName %></h1>

            <span class="view_buttons">
                <span class='type_views'>
                    <div class='dot8<% if (viewClass === 'dot8') { %> active<% } %>'>
                        <img src='/st/svg/dot8.svg' alt="">
                    </div>
                    <div class='dot4<% if (viewClass === 'dot4') { %> active<% } %>'>
                        <img src='/st/svg/dot4.svg' alt="">
                    </div>
                    <div class='dot1<% if (viewClass === 'dot1') { %> active<% } %>'>
                        <img src='/st/svg/dot1.svg' alt="">
                    </div>
                </span>

                <span class='coin' title="Отсортируйте по цене">
                    <span>цена <img src="/st/svg/arrow-down.svg" alt="" loading="lazy"
                     width='10' style="transform: rotate(-90deg)"></span>
                </span>
            </span>
        </div>
        <cards class="cards <%= viewClass %>">
            <% carsView.forEach(function(car, i) { %>
                <%- include('partials/car_card', {car: car, idx: i + 1}) %>
                <% if (i === 0) { %>
                    <div style="min-width: 200px; max-width: 730px"><swiper_buy></swiper_buy></div>
                <% } %>
                <% if (i === 2) { %>
                    <abdul><%- include('partials/abdul_block') %></abdul>
                <% } %>
            <% }); %>
            <div class="pager">Страницы: <span id="pager"><%- page %></span></div>
        </cards>
        <br><br>
    </div>


</main>

<%- include('partials/footer') %>

<script type="module" crossorigin src="/assets/<%- js3 %>"></script>
<script type="module" crossorigin src="/assets/<%- js4 %>"></script>
<script type="module" crossorigin src="/assets/<%- js5 %>"></script>
<script type="module" crossorigin src="/assets/<%- js6 %>"></script>
<script type="module" crossorigin src="/assets/<%- js7 %>"></script>
<script defer src='/st/swiper-bundle.min.js'></script>


