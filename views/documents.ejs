<!DOCTYPE html>
<html lang='ru'>
<head>
    <meta charset='UTF-8'/>
    <link rel='icon' type='image/svg+xml' sizes='any' href='/st/favicon.svg'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title><%= title %></title>
    <meta property='og:type' content='website'>
    <meta property='og:title' content='Документы'>
    <meta property='og:description' content='<%= description %>'>
    <meta property='og:image' content='<%= ogImage %>'>
    <link rel='canonical' href='<%= canonical %>'>
    <meta property='og:url' content='<%= canonical %>'>
    <meta property='og:locale' content='ru_RU'>
    <meta property='og:site_name' content='АВТОСЕТЬ.РФ'>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8'>
    <meta name='robots' content='index, follow'>
    <meta name='description' content='<%= description %>'>

    <link rel='stylesheet' crossorigin href='/<%= styleCss %>'>
    <link rel='sitemap' type='application/xml' title='Sitemap' href='/sitemap.xml'>

    <script type='module' crossorigin src='/<%= styleJs %>'></script>
    <script type='module' crossorigin src='/<%= mainJs %>'></script>

    <style>
        .page-header {
            margin-bottom: 2.5rem;
            border-left: 5px solid #c9252c;
            padding-left: 1.2rem;
        }

        .doc-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.02), 0 2px 6px rgba(0, 0, 0, 0.05);
            transition: all 0.2s ease;
            border: 1px solid #eef2f8;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            padding: 1.2rem 1.5rem;
            margin-bottom: 1rem;
        }

        .doc-card:hover {
            box-shadow: 0 12px 22px rgba(0, 0, 0, 0.08);
            border-color: #dce5ef;
        }

        .doc-info {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            flex: 2 1 260px;
        }

        .doc-icon {
            width: 52px;
            height: 52px;
            flex: 0 0 auto;
            background: #f0f4fa;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #c9252c;
            font-size: 1.8rem;
            transition: background 0.2s;
        }

        .doc-name {
            font-weight: 700;
            font-size: 1.12rem;
            color: #0f2b3f;
            letter-spacing: -0.2px;
            line-height: 1.3;
        }

        .doc-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            font-size: 0.8rem;
            color: #6c86a3;
            margin-top: 6px;
        }

        .doc-size {
            background: #eef2f9;
            padding: 0.2rem 0.7rem;
            border-radius: 30px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 500;
        }

        .doc-name-link {
            color: inherit;
            text-decoration: none;
        }

        .doc-name-link:hover {
            color: #c9252c;
        }

        .doc-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-left: 10px;
        }

        /* явная возможность открыть основной документ в новой вкладке — по наведению */
        .open-btn {
            font-size: 0.85rem;
            font-weight: 600;
            color: #c9252c;
            text-decoration: none;
            white-space: nowrap;
            opacity: 0;
            transform: translateX(6px);
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .open-btn:hover {
            text-decoration: underline;
        }

        .doc-card:hover .open-btn,
        .open-btn:focus-visible {
            opacity: 1;
            transform: none;
        }

        @media (hover: none) {
            .open-btn {
                opacity: 1;
                transform: none;
            }
        }

        .download-btn {
            background: transparent;
            border: 1.5px solid #c9252c;
            border-radius: 40px;
            padding: 10px 24px;
            font-weight: 600;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            color: #c9252c;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: white;
            text-decoration: none;
        }

        .download-btn:hover {
            background-color: #c9252c;
            color: white;
            border-color: #c9252c;
            box-shadow: 0 4px 10px rgba(201, 37, 44, 0.2);
        }

        /* второстепенные документы: проще и мельче основных */
        .doc-secondary {
            margin-top: 2.5rem;
        }

        .doc-secondary h2 {
            font-size: 1.15rem;
            color: #3b5670;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .doc-secondary__list {
            list-style: none;
            margin: 0;
            padding: 0;
            border-top: 1px solid #e2e8f0;
        }

        .doc-secondary__item {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            padding: 0.65rem 0;
            border-bottom: 1px solid #e2e8f0;
            font-size: 0.88rem;
        }

        .doc-secondary__link {
            color: #2b4a6b;
            text-decoration: none;
            line-height: 1.4;
        }

        .doc-secondary__link:hover {
            color: #c9252c;
            text-decoration: underline;
        }

        .doc-secondary__meta {
            flex: 0 0 auto;
            color: #8a9bb0;
            font-size: 0.78rem;
        }

        .footer-note {
            margin-top: 3.5rem;
            padding-top: 1.8rem;
            border-top: 1px solid #e2e8f0;
            font-size: 0.8rem;
            color: #6f8aac;
            text-align: center;
        }

        @media (max-width: 640px) {
            .doc-card {
                gap: 1rem;
            }

            .doc-actions {
                width: 100%;
                margin-left: 0;
                justify-content: center;
                flex-wrap: wrap;
            }

            .download-btn {
                width: 60%;
                justify-content: center;
                margin: auto;
            }
        }
    </style>
</head>
<body>

<%- include('partials/verbox') %>
<%- include('partials/ya_metrica') %>
<%- include('partials/header') %>

<main>
    <div class='page_padding_20'>
        <div class='bread_cranbs'>
            <a href='/'>Главная</a> /
            <span>Документы</span>
        </div>
    </div>

    <div class="container">
        <div class="page-header">
            <h1>Документы автосалона</h1>
            <p>Официальная информация, регулирующая отношения с клиентами, условия обработки данных и правовая база</p>
        </div>

        <% mainDocs.forEach((doc) => { %>
        <div class="doc-card">
            <div class="doc-info">
                <div class="doc-icon">✔</div>
                <div>
                    <div class="doc-name">
                        <% if (doc.previewable) { %>
                        <a class="doc-name-link" href="<%= doc.link %>" target="_blank" rel="noopener"><%= doc.name %></a>
                        <% } else { %>
                        <a class="doc-name-link" href="<%= doc.link %>" download><%= doc.name %></a>
                        <% } %>
                    </div>
                    <div class="doc-meta">
                        <span class="doc-size"><%= doc.formatText %>-документ</span>
                        <span class="doc-size"><%= doc.sizeText %></span>
                    </div>
                </div>
            </div>
            <div class="doc-actions">
                <% if (doc.previewable) { %>
                <a class="open-btn" href="<%= doc.link %>" target="_blank" rel="noopener"></a>
                <% } %>
                <a href="<%= doc.link %>" download class="download-btn">
                    <span style="font-size: large"> ≚ </span> Скачать
                </a>
            </div>
        </div>
        <% }) %>

        <% if (!mainDocs.length && !secondaryDocs.length) { %>
        <p>Документы пока не опубликованы.</p>
        <% } %>

        <% if (secondaryDocs.length) { %>
        <section class="doc-secondary">
            <h2>Дополнительные документы</h2>
            <ul class="doc-secondary__list">
                <% secondaryDocs.forEach((doc) => { %>
                <li class="doc-secondary__item">
                    <a class="doc-secondary__link" href="<%= doc.link %>"<% if (doc.previewable) { %> target="_blank" rel="noopener"<% } else { %> download<% } %>><%= doc.name %></a>
                    <span class="doc-secondary__meta"><%= doc.formatText %> · <%= doc.sizeText %></span>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <div class="footer-note">
            Автосеть.РФ — официальные документы.
        </div>
        <br><br>
    </div>
</main>

<%- include('partials/footer') %>

</body>
</html>
