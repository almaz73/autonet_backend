                    <div class="frame-filter__item">
                        <span class='comb' data-placeholder='Высота профиля'/>
                    </div>
                    <div class="frame-filter__item">
                        <span class='comb' data-placeholder='Диаметр'/>
                    </div>
                    <div class="frame-filter__item no_advanced">
