                        </div>
                        <div class='cart__info'>
                            <%= el.milleage %>км, <%- el.engineCapacity %> <%- el.gearboxType %> (<%- el.enginePower %>
                            л.с.)
                            <%= el.bodyType %> <%= el.driveType %> <%= el.engineType %>
