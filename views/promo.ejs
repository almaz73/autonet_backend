<!DOCTYPE html>
<html lang='ru'>
<head>
    <link rel='icon' type='image/svg+xml' sizes='any' href='../../st/favicon.svg'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'/>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title><%= title %> - Автосеть.РФ</title>
    <meta property='og:type' content='website'>
    <meta property='og:title' content='<%= title %>'>
    <meta property='og:image' content='https://xn--80aej9aped4f.xn--p1ai/st/auto.webp'>
    <meta property='og:url' content='https://автосеть.рф/promo/644340'>
    <meta property='og:locale' content='ru_RU'>
    <meta property='og:site_name' content='АВТОСЕТЬ.РФ'>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8'>
    <meta name='robots' content='index, follow'>
    <meta name='description' content='Специальные предложения и акции в автосалонах Автосеть.рф.'>
    <script type="module" crossorigin src="../../assets/<%- js1 %>"></script>
    <script type="module" crossorigin src="../../assets/<%- js2 %>"></script>
    <script type="module" crossorigin src="../../assets/<%- js3 %>"></script>
    <link rel="stylesheet" crossorigin href="../../assets/<%- css1 %>">
    <link rel="stylesheet" crossorigin href="../../<%- css2 %>">
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
</head>
<body>

<%- include('partials/verbox') %>
<%- include('partials/ya_metrica') %>
<%- include('partials/header') %>

<main>

    <div class='page_padding_20'>
        <div class='bread_cranbs'>
            <a href='/'>Главная</a>
            <a href='/promo/' title='Акции и спецпредложения'>Акции и спецпредложения</a>
            <span><%= title %></span>
        </div>
    </div>

    <div class='container promo-banner'>
        <img src='../../pub_promo/<%- photo1200 %>' alt='<%= title %>' class='big'>
        <img src='../../pub_promo/<%- photo278 %>' alt='<%= title %>' class='small'>
    </div>


    <div class='container' style='padding: 40px 0 0'>
        <h1><%= title %></h1>
    </div>

    <div class='container'>
        <!--/* раньше это было в rightPanel */-->

        <div class="promo-detail-call__wrap">
            <div class="div">
                <h3>Закажите обратный звонок</h3>

                <p class="pp">Просто оставьте свои контактные данные и мы сами вам перезвоним!</p>
            </div>


            <div class="div promo-form">
                <div class="formBlock">
                    <div class="form__modal--group">
                        <div class="form__group">
                            <input name="name"  required  placeholder="Ваше имя *">
                        </div>
                    </div>
                    <div class="form__modal--group">
                        <div class="form__group">
                            <input name="year" placeholder="Год выпуска">
                        </div>
                    </div>

                    <div class="form__modal--group">
                        <div class="capctha-div"></div>
                    </div>

                    <button class="page__btn page__btn--current" onclick="sendBidPromo()">
                        <span> Отправить заявку </span>
                    </button>

                    <div class="modal__personal">
                        <input type="checkbox" id="dd1d">
                        <label for="dd1d"> Нажав кнопку «Отправить заявку» я даю согласие на обработку
                            персональных <a href="/privacy-policy/" target="_blank">данных</a>
                        </label>
                    </div>
                </div>
            </div>

        </div>    </div>


    <div class='container'>
        <h2>Другие акции</h2>
    </div>

    <div class='container promo-photos'></div>
    <div style="text-align: center">
        <h3><a href="/promo/"> Другие акции</a></h3>
    </div>
</main>

<%- include('partials/footer') %>


</body>
</html>
